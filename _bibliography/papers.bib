@article{10.13140/RG.2.2.35037.68329,
  title={Practical Approaches to Democratizing LLMs: Efficiency, Retrieval, and Distributed Serving},
  abstract={Large Language Models (LLMs) have revolutionized artificial intelligence, yet their accessibility remains limited by immense computational and infrastructural demands. While cloud computing has enabled scalability, its high cost and centralization threaten the vision of truly democratized AI. This mini-survey reviews practical innovations that bridge this divide through efficiency and decentralization. We highlight parameter efficient fine-tuning (e.g., LoRA, QLoRA), memory optimized distributed training (e.g., ZeRO, Switch Transformer), knowledge integration techniques (retrieval-augmented generation and knowledge distillation), all of which reduce the resource footprint of large models. We further examine open source inference frameworks such as Ray Serve and NVIDIA Triton, illustrating how distributed deployment can lower infrastructural barriers. Together, these developments chart a path toward community driven, affordable, and inclusive AI participation .},
  year={2025},
  month={November},
  publisher=rg,
  url={https://www.researchgate.net/publication/397186031_Practical_Approaches_to_Democratizing_LLMs_Efficiency_Retrieval_and_Distributed_Serving},
  html={https://www.researchgate.net/publication/397186031_Practical_Approaches_to_Democratizing_LLMs_Efficiency_Retrieval_and_Distributed_Serving},
  pdf={https://www.researchgate.net/publication/397186031_Practical_Approaches_to_Democratizing_LLMs_Efficiency_Retrieval_and_Distributed_Serving},
  preview={rg.png},
  selected={true}
}

@article{none,
  title={Fractional Ownership of Real Estate Using Asset Tokenization in Blockchain},
  abstract={Fractional ownership has emerged as a ground-breaking concept in real estate investment, enabling individualsto possess a fraction of a property, thus mitigating the demandfor substantial capital outlays. This innovative approach isgaining rapid traction within the real estate sector due to itsenhanced flexibility and increased investment fluidity. Blockchaintechnology is reshaping the real estate landscape, offering anefficient and transparent transaction platform. By creating digitaltokens representing property ownership, blockchain facilitatesfractional ownership, enabling seamless trading and transfer ofownership. This convergence democratizes property investment,providing access to the real estate market for smaller-scaleinvestors. Additionally, it imparts heightened liquidity and adapt-ability, empowering investors to engage in buying, selling, andtrading tokens via the blockchain infrastructure. Furthermore,it establishes a secure and transparent environment, immune tomanipulation, as all transactions are indelibly recorded on theblockchain ledger. Contemporary real estate platforms enableinvestors to acquire tokens symbolizing property ownership, withthe added incentive of receiving rental yields. This paper exploresthe implementation of a blockchain-based fractional ownershipsystem using Ethereum’s Sepolia test network, demonstratinghow this technology can revolutionize real estate investment},
  year={2023},
  month={August},
  publisher=rg,
  url={https://www.researchgate.net/publication/396657234_Fractional_Ownership_of_Real_Estate_Using_Asset_Tokenization_in_Blockchain},
  html={https://www.researchgate.net/publication/396657234_Fractional_Ownership_of_Real_Estate_Using_Asset_Tokenization_in_Blockchain},
  pdf={https://www.researchgate.net/publication/396657234_Fractional_Ownership_of_Real_Estate_Using_Asset_Tokenization_in_Blockchain},
  preview={rg.png},
  selected={true}
}